# Example only: no credentials. Copy to /etc/hildors/team-staging.env on the approved test host.
HILDORS_MODE=team-staging
HILDORS_PORT=8787
HILDORS_ENABLE_DOWNLOADS=0
HILDORS_DATA_DIR=/var/lib/hildors-api
HILDORS_ADMIN_TOKEN_FILE=/etc/hildors/admin-token
HILDORS_ADMIN_USERNAME=hildors-admin
HILDORS_ADMIN_PASSWORD_FILE=/etc/hildors/admin-password
HILDORS_FFMPEG=/usr/bin/ffmpeg
HILDORS_FFPROBE=/usr/bin/ffprobe
